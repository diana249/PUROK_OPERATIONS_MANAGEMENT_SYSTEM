DEBUG=0
SECRET_KEY=replace-with-a-very-strong-random-secret
ALLOWED_HOSTS=your-domain.com,www.your-domain.com
CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# Security hardening
SECURE_SSL_REDIRECT=1
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=1
SECURE_HSTS_PRELOAD=1
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
LOG_LEVEL=INFO

# Use MySQL for production (DMS requirement)
DB_ENGINE=mysql
DB_NAME=purok_system
DB_USER=purok_user
DB_PASSWORD=replace-with-db-password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_CONN_MAX_AGE=120
DB_INIT_COMMAND=SET sql_mode='STRICT_TRANS_TABLES,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION'
DATABASE_URL=

# Email (set SMTP credentials for real email delivery)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@your-domain.com
